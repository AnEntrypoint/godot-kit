[
  {
    "id": "protocol-vector2i-vector3i-decode",
    "subject": "Decode VECTOR2I, VECTOR3I, VECTOR4, VECTOR4I, RECT2, RECT2I, AABB, BASIS, TRANSFORM2D, TRANSFORM3D, QUATERNION, PLANE variants",
    "status": "pending",
    "description": "lib/protocol.js decodeVariant handles VECTOR2, VECTOR3, COLOR, OBJECT, ARRAY, DICTIONARY, STRING, INT, FLOAT, BOOL, NIL. Missing: VECTOR2I, VECTOR3I, VECTOR4, VECTOR4I, RECT2, RECT2I, AABB, BASIS, TRANSFORM2D, TRANSFORM3D, QUATERNION, PLANE, PROJECTION, CALLABLE, SIGNAL, RID, PACKED_* arrays. These fall through to default '<type:N>' string. Agents inspecting physics/transform properties get garbage.",
    "blocking": [],
    "blockedBy": [],
    "effort": "medium",
    "category": "bug",
    "acceptance": [
      "VECTOR2I, VECTOR3I decode as {x,y} ints",
      "VECTOR4, VECTOR4I decode as {x,y,z,w}",
      "RECT2 decodes as {position:{x,y}, size:{x,y}}",
      "AABB decodes as {position:{x,y,z}, size:{x,y,z}}",
      "TRANSFORM2D decodes as {x,y,origin} axes",
      "PACKED_BYTE_ARRAY, PACKED_INT32_ARRAY, PACKED_FLOAT32_ARRAY decode as JS arrays",
      "PACKED_STRING_ARRAY decodes as string array",
      "CALLABLE, SIGNAL, RID return descriptive object not '<type:N>'"
    ],
    "edge_cases": [
      "BASIS is 3x VECTOR3 = 36 bytes",
      "TRANSFORM3D is BASIS + VECTOR3 = 48 bytes",
      "PROJECTION is 4x VECTOR4 = 64 bytes",
      "PACKED arrays have element count header"
    ]
  },
