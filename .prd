  {
    "id": "game-bridge-watch-persist-reuse",
    "subject": "game watch creates new watch every invocation — no way to check if watch already exists",
    "status": "pending",
    "description": "lib/cli-game.js watch command always POSTs /watch creating a new watch id. Running the command twice on same expr leaks watches. game watches shows all active watches but there's no dedup or reuse by expr.",
    "blocking": [],
    "blockedBy": [],
    "effort": "small",
    "category": "feature",
    "acceptance": [
      "GET /watches returns existing watch for expr if already registered",
      "or: cli watch command checks /watches first, reuses existing id if expr matches"
    ],
    "edge_cases": [
      "multiple callers watching same expr is valid — only deduplicate within single CLI invocation"
    ]
  },
  {
    "id": "connection-auto-http-eval-shape",
    "subject": "Connection HTTP eval returns {result, error} dict but TCP path returns raw decoded variant",
    "status": "pending",
    "description": "lib/connection.js Connection.eval() routes to HTTP POST /eval (returns {result,error}) or TCP _request (returns decoded variant which is already {result,error} dict from GDScript). This is actually consistent — but Connection.tree() TCP path resolves with the raw params array, not a normalized shape. Each method's return shape differs by transport — callers must know which transport is active.",
    "blocking": [],
    "blockedBy": [],
    "effort": "medium",
    "category": "refactor",
    "acceptance": [
      "Connection methods normalize return shapes regardless of transport",
      "eval() always returns {result, error}",
      "tree() always returns {tree: {...}}",
      "perf() always returns perf dict",
      "globals() always returns {globals: [...]}"
    ],
    "edge_cases": [
      "TCP returns decoded variant which may be the dict directly if bridge sends it as dict",
      "Verify actual TCP response shape before normalizing"
    ]
  },
